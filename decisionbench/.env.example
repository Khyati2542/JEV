# Copy to .env and edit. Every default works offline with zero cost.

# ---- Model -----------------------------------------------------------------
# Any small open-weight instruct model your local server can load.
# Tested shapes: Qwen2.5-1.5B-Instruct, Qwen2.5-3B-Instruct, Qwen2.5-7B-Instruct
MODEL_NAME=Qwen/Qwen2.5-3B-Instruct

# ---- Local inference server ------------------------------------------------
# SGLang serves /v1/score, which is what the Jev-style engine prefers.
SGLANG_BASE_URL=http://127.0.0.1:30000
# Generation endpoints. Defaults to SGLANG_BASE_URL; point elsewhere if you run
# generation on a different server (e.g. vLLM or llama.cpp).
# GEN_BASE_URL=http://127.0.0.1:30000

REQUEST_TIMEOUT_S=120
HEALTH_TIMEOUT_S=2.5
HEALTH_CACHE_S=15

MAX_NEW_TOKENS=64
TEMPERATURE=0

# auto  -> use the model's chat template via transformers, else Qwen ChatML
# qwen  -> always hand-build Qwen ChatML
# raw   -> send the bare prompt with no chat wrapper
CHAT_TEMPLATE=auto

# ---- Demo mode -------------------------------------------------------------
# Set to 1 to force demo mode even when a model server is running.
FORCE_DEMO=0

# ---- Human-review policy ---------------------------------------------------
# APPLICATION-LEVEL policy, not a property of Jev or of the model.
# Auto-decide requires: top >= AUTO_DECIDE_MIN_TOP
#                   AND (top - second) >= AUTO_DECIDE_MIN_MARGIN
AUTO_DECIDE_MIN_TOP=0.80
AUTO_DECIDE_MIN_MARGIN=0.20

# ---- Server ----------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=*
